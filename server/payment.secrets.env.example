# 复制为 payment.secrets.env 并填写真实密钥（勿提交 git）
# cp payment.secrets.env.example payment.secrets.env

# 站点公网地址（用于生成回调，也可在 .env 设 PAYMENT_SITE_BASE_URL）
# PAYMENT_SITE_BASE_URL=https://appeal.aikex.ink

# ---------- 微信支付 APIv3 ----------
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
# 二选一：私钥 PEM 全文（多行用 \n），或服务器文件路径
WECHAT_PAY_PRIVATE_KEY_PATH=/root/我的项目/merchant-appeal/server/certs/wechat/apiclient_key.pem
# 平台证书（回调验签，仅 .env 生效，不放数据库）
WECHAT_PAY_CERT_PATH=/root/我的项目/merchant-appeal/server/certs/wechat/wechatpay_platform.pem

# ---------- 支付宝 电脑网站支付 ----------
ALIPAY_APP_ID=
# 应用私钥（可整段 PEM，一行内用 \n 表示换行）
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
