# ============================================
# 商户号申诉助手 - 环境变量配置示例
# ============================================
# 复制此文件为 .env 并填写实际值

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=merchant_appeal

# 数据库连接（备用格式）
# DATABASE_URL=mysql://user:password@localhost:3306/merchant_appeal

# 服务配置
PORT=3001
NODE_ENV=development

# JWT密钥（生产环境请使用强随机字符串）
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# 数据加密密钥（64位十六进制字符串）
ENCRYPT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# DeepSeek API配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 闲鱼管家 API配置（可选）
# 申请地址: https://open.goofish.pro
XIANGUAN_BASE_URL=https://open.goofish.pro
XIANGUAN_APPID=your_xianguan_appid
XIANGUAN_APPSECRET=your_xianguan_appsecret

# 前端配置
VITE_APP_TITLE=商户号申诉助手
VITE_API_BASE_URL=http://localhost:3001
